# ============================================================
# .env.example – Nestify AI Microservice
# ============================================================
# Copy this file to .env and fill in your real values.
# Never commit the real .env to version control.
# ============================================================

# ── General ─────────────────────────────────────────────────
APP_NAME=Nestify AI Service
APP_VERSION=1.0.0
DEBUG=true

# ── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In development: allow all with *
# In production: restrict to your actual domains.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ── PostgreSQL ───────────────────────────────────────────────
# Not used yet (Phase 1 uses dummy data).
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://nestify_user:password@localhost:5432/nestify_db

# ── Roommate Matching ────────────────────────────────────────
# Default number of matches to return per query
ROOMMATE_TOP_K=5

# ── Tagging Model ────────────────────────────────────────────
# Minimum confidence score to include a tag (0.0 – 1.0)
TAGGING_CONFIDENCE_THRESHOLD=0.3
